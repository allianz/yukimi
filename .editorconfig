# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,Makefile.*,*.mk}]
indent_style = tab

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,tmpl}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

# Markdown: trailing whitespace is significant (two spaces = hard line break).
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
