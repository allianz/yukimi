# AWS Configuration for Integration Tests
# Copy this file to .env and fill in your values
# DO NOT commit .env file (it's in .gitignore)

# AWS Region where Secrets Manager stores credentials
AWS_REGION=eu-central-1

# (Optional) AWS Profile from ~/.aws/credentials for local development
# If not set, will use default credential chain (environment variables, EC2 instance profile, etc.)
AWS_PROFILE=dev


# ============================================================================
# Snowflake Configuration
# ============================================================================

# Snowflake Organization Name
# Used to construct account identifiers and credential paths
SNOWFLAKE_ORG=<my_org_name>

# Org Admin Account Name
# Account used for organization-level operations (e.g., creating new accounts, setting org policies)
# AWS secret path: snowflake/org/${SNOWFLAKE_ORG}/${SNOWFLAKE_ORG_ADMIN_ACCOUNT}/org-admin-credentials
SNOWFLAKE_ORG_ADMIN_ACCOUNT=platform

# Set to "false" to connect without PrivateLink
# SNOWFLAKE_USE_PRIVATELINK=true

# (Optional) Bypass OCSP certificate-revocation checks — testing/emergency only,
# see specs/004-connection-pooling.md. Set to "true" to bypass.
# SNOWFLAKE_DISABLE_OCSP_CHECKS=true

# ============================================================================
# Simulated customer account for integration testing
# ============================================================================

# Kubernetes namespace simulating a customer's tenant
SAMPLE_CUSTOMER_NAMESPACE=test

# Snowflake account inside that tenant, simulating a customer's account
# AWS secret path: snowflake/tenant/${SNOWFLAKE_ORG}/${SAMPLE_CUSTOMER_NAMESPACE}/${SAMPLE_CUSTOMER_ACCOUNT}/platform-credentials
SAMPLE_CUSTOMER_ACCOUNT=test

# Account locator Snowflake assigned to the sample customer account (design.md 3.6)
SAMPLE_CUSTOMER_ACCOUNT_LOCATOR=<snowflake-locator>

# Cloud-region the sample customer account lives in — <cloud>-<region-id>, matching the
# SnowflakeAccount CRD's `region` field and Backplane Config region keys (design.md 3.1, 3.5)
SAMPLE_CUSTOMER_ACCOUNT_REGION=aws-eu-central-1
